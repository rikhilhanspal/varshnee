  "title": "Directions",
  "description": "Learn how to ask for and give directions in Tamil — left, right, straight, and near.",
  "vocabularyIds": ["ta-idadhu", "ta-valadhu", "ta-neraaga", "ta-pakkathu", "ta-enga"],
