      "direction": "from_english",
      "correct": "periya veedu",
      "acceptedVariants": [
        "periya veedu"
      ],
      "explanation": "'Periya veedu' = big house. In Tamil, the adjective 'periya' comes before the noun 'veedu'.",
      "hint": "sounds like: periya veedu"
    },
    {
      "id": "ta-s2-l6-ex04",
      "type": "fill_in_blank",
