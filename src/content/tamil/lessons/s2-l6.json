{
  "id": "s2-l6",
  "sectionId": "s2",
  "title": "Numbers 11–20",
  "description": "Learn to count from eleven to twenty in colloquial Tamil.",
  "vocabularyIds": ["ta-pathinonnu", "ta-pannrendu", "ta-pathinmoonu", "ta-pathinnaalu", "ta-pathinanju", "ta-pathinaaru", "ta-pathineyelu", "ta-pathinettu", "ta-pathombadu", "ta-irupathu"],
  "grammarNoteIds": [],
  "exercises": [
    {
      "id": "ta-s2-l6-ex01",
      "type": "matching",
      "pairs": [
        { "left": "pathinonnu", "right": "11" },
        { "left": "pannrendu", "right": "12" },
        { "left": "pathinmoonu", "right": "13" },
        { "left": "pathinnaalu", "right": "14" }
      ],
      "explanation": "Numbers 11–14. Notice that 11, 13, and 14 are formed with 'pathin' (ten) + the unit number."
    },
    {
      "id": "ta-s2-l6-ex02",
      "type": "matching",
      "pairs": [
        { "left": "pathinanju", "right": "15" },
        { "left": "pathinaaru", "right": "16" },
        { "left": "pathineyelu", "right": "17" },
        { "left": "pathinettu", "right": "18" }
      ],
      "explanation": "Numbers 15–18 follow the pattern pathin + unit (anju, aaru, yelu, ettu)."
    },
    {
      "id": "ta-s2-l6-ex03",
      "type": "multiple_choice",
      "question": "What is 'irupathu' in English?",
      "options": ["18", "19", "20", "15"],
      "correctIndex": 2,
      "explanation": "'Irupathu' means 20 in Tamil — iru (two) + pathu (ten) = twenty."
    },
    {
      "id": "ta-s2-l6-ex04",
      "type": "translation",
      "prompt": "19",
      "direction": "from_english",
      "correct": "pathombadu",
      "acceptedVariants": ["pathombadu"],
      "explanation": "'Pathombadu' = 19 — pathu (ten) + ombadu (nine).",
      "hint": "sounds like: pa-thom-ba-du"
    },
    {
      "id": "ta-s2-l6-ex05",
      "type": "fill_in_blank",
      "sentence": "Pathinanju, pathinaaru, pathineyelu, ___, pathombadu. (15, 16, 17, ___, 19)",
      "correct": "pathinettu",
      "acceptedVariants": ["pathinettu"],
      "explanation": "'Pathinettu' = 18, coming between 17 and 19."
    },
    {
      "id": "ta-s2-l6-ex06",
      "type": "translation",
      "prompt": "pannrendu",
      "direction": "to_english",
      "correct": "12",
      "acceptedVariants": ["12", "twelve"],
      "explanation": "'Pannrendu' is 12 — an irregular form (not pathin + rendu)."
    },
    {
      "id": "ta-s2-l6-ex07",
      "type": "multiple_choice",
      "question": "How do you ask 'how old are you?' in Tamil?",
      "options": ["onga evvalavu vayasu", "onga vayasu evvalavu", "eppo vayasu", "enna vayasu"],
      "correctIndex": 1,
      "explanation": "'Onga vayasu evvalavu?' = how old are you? — vayasu = age, evvalavu = how much/many."
    },
    {
      "id": "ta-s2-l6-ex08",
      "type": "word_ordering",
      "prompt": "Put 18, 19, 20 in order",
      "tiles": [
        { "id": "t1", "text": "irupathu" },
        { "id": "t2", "text": "pathombadu" },
        { "id": "t3", "text": "pathinettu" }
      ],
      "correctOrder": ["t3", "t2", "t1"],
      "explanation": "pathinettu (18) → pathombadu (19) → irupathu (20)"
    }
  ]
}
