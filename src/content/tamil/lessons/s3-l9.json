      ],
      "correctIndex": 2,
      "explanation": "'Kadai' means shop or store. 'Kadai enga irukku?' means 'Where is the shop?'"
    },
    {
      "id": "ta-s3-l9-ex03",
      "type": "translation",
      "prompt": "Where is the school?",
      "direction": "from_english",
      "correct": "palli enga irukku",
      "acceptedVariants": [
        "palli enga iruku",
        "palli enga irrukku"
      ],
      "explanation": "'Palli enga irukku?' uses the pattern: place + where + is-it. 'Irukku' means 'is (located)'.",
      "hint": "sounds like: palli enga irukku"
    },
