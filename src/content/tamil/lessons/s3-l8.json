  "exercises": [
    {
      "id": "ta-s3-l8-ex01",
      "type": "matching",
      "pairs": [
        {
          "left": "poga",
          "right": "to go"
        },
        {
          "left": "vara",
          "right": "to come"
        },
        {
          "left": "saapida",
          "right": "to eat"
        },
        {
          "left": "kudikka",
          "right": "to drink"
        },
        {
          "left": "pesa",
          "right": "to speak"
        }
      ],
      "explanation": "These are the most common Tamil verbs in their infinitive form (ending in '-a')."
    },
    {
      "id": "ta-s3-l8-ex02",
      "type": "multiple_choice",
      "question": "What does 'pidikkum' mean?",
      "options": [
        "to want",
        "to go",
        "to like",
        "to speak"
      ],
      "correctIndex": 2,
      "explanation": "'Pidikkum' means 'to like'. It uses a dative construction: 'enakku dosai pidikkum' (I like dosa)."
    },
    {
      "id": "ta-s3-l8-ex03",
      "type": "translation",
      "prompt": "I like coffee",
      "direction": "from_english",
      "correct": "enakku kaapi pidikkum",
      "acceptedVariants": [
        "enaku kaapi pidikkum",
        "enakku kaappi pidikkum"
      ],
      "explanation": "'Enakku kaapi pidikkum' literally means 'to-me coffee is-liked'. Tamil uses a dative subject for 'like'.",
      "hint": "sounds like: enakku kaapi pidikkum"
    },
    {
      "id": "ta-s3-l8-ex04",
      "type": "fill_in_blank",
      "sentence": "Naan veedu ___ pogein.",
      "correct": "kku",
      "acceptedVariants": [
        "kku",
        "ku"
      ],
      "explanation": "'Naan veedu kku pogein' means 'I am going home'. The suffix '-kku' indicates direction (to)."
    },
    {
      "id": "ta-s3-l8-ex05",
      "type": "listening",
      "audio": "tamil/saapida.mp3",
      "mode": "type",
      "correct": "saapida",
      "acceptedVariants": [
        "saapida",
        "sapida",
        "saappida"
      ],
      "explanation": "'Saapida' means 'to eat' and is pronounced 'saa-pi-dah'."
    },
    {
      "id": "ta-s3-l8-ex06",
      "type": "word_ordering",
      "prompt": "Arrange to say 'I want to go':",
      "tiles": [
        {
          "id": "t1",
          "text": "venum"
        },
        {
          "id": "t2",
          "text": "enakku"
        },
        {
          "id": "t3",
          "text": "poga"
        }
      ],
      "correctOrder": [
        "t2",
        "t3",
        "t1"
      ],
      "explanation": "'Enakku poga venum' = I want to go (literally: to-me to-go is-needed)."
    },
    {
      "id": "ta-s3-l8-ex07",
      "type": "translation",
      "prompt": "kudikka",
      "direction": "to_english",
      "correct": "to drink",
      "acceptedVariants": [
        "drink",
        "to drink"
      ],
      "explanation": "'Kudikka' is the infinitive form meaning 'to drink'."
    },
    {
      "id": "ta-s3-l8-ex08",
      "type": "multiple_choice",
      "question": "Which verb means 'to speak'?",
      "options": [
        "poga",
