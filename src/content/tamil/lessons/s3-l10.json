      "sentence": "Oru ___ kodunga. (Give me one tea.)",
      "correct": "chai",
      "acceptedVariants": ["chai"],
      "explanation": "'Oru chai kodunga' = give me one tea. Oru = one, chai = tea, kodunga = please give."
    },
