      "id": "ta-s3-l10-ex05",
      "type": "translation",
      "prompt": "tanni",
      "direction": "to_english",
      "correct": "water",
      "acceptedVariants": ["water"],
      "explanation": "'Tanni' means water in colloquial Tamil."
    },
    {
      "id": "ta-s3-l10-ex06",
      "type": "multiple_choice",
      "question": "What is the Tamil word for coffee?",
      "options": ["tanni", "chai", "kaapi", "pazhaneer"],
      "correctIndex": 2,
      "explanation": "'Kaapi' is the Tamil word for coffee — specifically South Indian filter coffee, a cultural staple."
