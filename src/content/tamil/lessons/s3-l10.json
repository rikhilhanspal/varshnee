      "type": "multiple_choice",
      "question": "How do you ask for water in Tamil?",
      "options": ["enakku kaapi vendum", "enakku tanni vendum", "enakku chai vendum", "enakku pazhaneer vendum"],
      "correctIndex": 1,
      "explanation": "'Enakku tanni vendum' = I want water. Or simply say 'tanni kodunga' (please give water)."
    },
    {
      "id": "ta-s3-l10-ex03",
      "type": "translation",
      "prompt": "give me coffee please",
      "direction": "from_english",
      "correct": "kaapi kodunga",
      "acceptedVariants": ["kaapi kodunga", "enakku kaapi kodunga"],
      "explanation": "'Kaapi kodunga' = please give (me) coffee. 'Kodunga' is a polite way to ask for something.",
      "hint": "sounds like: kaa-pi ko-dung-guh"
    },
