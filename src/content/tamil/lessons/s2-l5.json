      "question": "What does 'anna' mean?",
      "options": [
        "younger brother",
        "elder brother",
        "younger sister",
        "elder sister"
      ],
      "correctIndex": 1,
      "explanation": "'Anna' means elder brother. Tamil distinguishes between elder (anna) and younger (thambi) brothers."
    },
