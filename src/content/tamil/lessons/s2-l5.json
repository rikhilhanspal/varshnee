      "acceptedVariants": ["anju"],
      "explanation": "'Anju' is 5 in colloquial Tamil.",
      "hint": "sounds like: un-ju"
    },
    {
      "id": "ta-s2-l5-ex05",
      "type": "fill_in_blank",
      "sentence": "Onnu, rendu, moonu, ___, anju. (1, 2, 3, ___, 5)",
      "correct": "naalu",
      "acceptedVariants": ["naalu"],
      "explanation": "Fill in the missing number — naalu is 4, coming between moonu (3) and anju (5)."
    },
    {
      "id": "ta-s2-l5-ex06",
      "type": "word_ordering",
      "prompt": "Put 6, 7, 8 in order",
      "tiles": [
        { "id": "t1", "text": "ettu" },
        { "id": "t2", "text": "aaru" },
        { "id": "t3", "text": "yelu" }
      ],
      "correctOrder": ["t2", "t3", "t1"],
      "explanation": "aaru (6) → yelu (7) → ettu (8)"
    },
    {
      "id": "ta-s2-l5-ex07",
      "type": "translation",
      "prompt": "ombadu",
      "direction": "to_english",
      "correct": "9",
      "acceptedVariants": ["9", "nine"],
      "explanation": "'Ombadu' is 9 in Tamil."
    },
    {
      "id": "ta-s2-l5-ex08",
      "type": "multiple_choice",
      "question": "How do you say 'I want 3' in Tamil?",
      "options": ["enakku naalu vendum", "enakku moonu vendum", "enakku rendu vendum", "enakku anju vendum"],
      "correctIndex": 1,
      "explanation": "'Enakku moonu vendum' = I want 3 (of something). 'Enakku vendum' is how you say 'I want/need' in Tamil."
    }
  ]
