      "explanation": "'Barah' is 12 in Hindi."
    },
    {
      "id": "hi-s2-l6-ex07",
      "type": "multiple_choice",
      "question": "How do you ask 'how old are you?' informally in Hindi?",
      "options": ["tum kab ho", "tumhari umar kitni hai", "tum kitne ho", "kab umar hai"],
      "correctIndex": 1,
      "explanation": "'Tumhari umar kitni hai?' = how old are you? (informal). Umar = age, kitni = how much (feminine)."
    },
    {
      "id": "hi-s2-l6-ex08",
      "type": "word_ordering",
      "prompt": "Put 18, 19, 20 in order",
      "tiles": [
        { "id": "t1", "text": "bees" },
        { "id": "t2", "text": "unnis" },
        { "id": "t3", "text": "atharah" }
      ],
      "correctOrder": ["t3", "t2", "t1"],
      "explanation": "atharah (18) → unnis (19) → bees (20)"
