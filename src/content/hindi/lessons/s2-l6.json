  "title": "Numbers 11–20",
  "description": "Learn to count from eleven to twenty in Hindi.",
  "vocabularyIds": ["hi-gyarah", "hi-barah", "hi-terah", "hi-chaudah", "hi-pandrah", "hi-solah", "hi-satrah", "hi-atharah", "hi-unnis", "hi-bees"],
  "grammarNoteIds": [],
  "exercises": [
