  "exercises": [
    {
      "id": "hi-s2-l6-ex01",
      "type": "matching",
      "pairs": [
        {
          "left": "laal",
          "right": "red"
        },
        {
          "left": "neela",
          "right": "blue"
        },
        {
          "left": "hara",
          "right": "green"
        },
        {
          "left": "peela",
          "right": "yellow"
        },
        {
          "left": "safed",
          "right": "white"
        }
      ],
      "explanation": "These are the most common Hindi colors. Notice that 'neela', 'hara', and 'peela' end in 'a' — they will change to 'i' when describing feminine nouns."
    },
    {
      "id": "hi-s2-l6-ex02",
      "type": "multiple_choice",
      "question": "What color is 'kaala'?",
      "options": [
        "Black",
        "White",
        "Red",
        "Blue"
      ],
      "correctIndex": 0,
      "explanation": "'Kaala' means black. Its opposite is 'safed' (white). Note that 'kaala' changes to 'kaali' for feminine nouns: 'kaali raat' (dark night)."
    },
    {
      "id": "hi-s2-l6-ex03",
      "type": "fill_in_blank",
      "sentence": "Yeh ghar bahut ___ hai.",
      "correct": "bada",
      "acceptedVariants": [
        "badi"
      ],
      "explanation": "'Yeh ghar bahut bada hai' means 'This house is very big'. Since 'ghar' (house) is masculine, we use 'bada'. For a feminine noun, it would be 'badi'."
    },
    {
      "id": "hi-s2-l6-ex04",
      "type": "translation",
      "prompt": "How do you say 'small' in Hindi?",
      "direction": "from_english",
      "correct": "chhota",
      "acceptedVariants": [
        "chhoti"
      ],
      "explanation": "'Chhota' means small (masculine). It becomes 'chhoti' for feminine nouns. For example: 'chhota bachha' (small child, boy) vs 'chhoti bachhi' (small child, girl).",
      "hint": "sounds like: chhota"
    },
    {
      "id": "hi-s2-l6-ex05",
      "type": "listening",
      "audio": "hindi/hara.mp3",
      "mode": "select",
      "options": [
        "hara (green)",
        "laal (red)",
        "peela (yellow)",
        "neela (blue)"
      ],
      "correctIndex": 0,
      "explanation": "'Hara' (huh-rah) means green. It is used to describe nature: 'hara ped' (green tree), 'hari ghaas' (green grass — feminine form 'hari')."
    },
    {
      "id": "hi-s2-l6-ex06",
      "type": "multiple_choice",
      "question": "How does the adjective 'bada' (big) change for a feminine noun?",
      "options": [
        "badi",
        "bade",
        "bado",
        "It does not change"
      ],
      "correctIndex": 0,
      "explanation": "Adjectives ending in 'a' change to 'i' for feminine singular nouns: 'bada ghar' (big house, masc.) becomes 'badi kitaab' (big book, fem.). They change to 'e' for masculine plural: 'bade ghar' (big houses)."
    },
    {
      "id": "hi-s2-l6-ex07",
      "type": "word_ordering",
      "prompt": "Say: The red flower is good",
      "tiles": [
        {
          "id": "t1",
          "text": "phool"
        },
        {
          "id": "t2",
          "text": "hai"
        },
        {
          "id": "t3",
          "text": "laal"
        },
        {
          "id": "t4",
          "text": "achha"
        }
      ],
      "correctOrder": [
        "t3",
        "t1",
        "t4",
        "t2"
      ],
      "explanation": "'Laal phool achha hai' — in Hindi, the adjective comes before the noun it describes: 'laal phool' (red flower). The verb 'hai' goes at the end."
    },
    {
      "id": "hi-s2-l6-ex08",
      "type": "translation",
      "prompt": "How do you say 'good' in Hindi?",
      "direction": "from_english",
      "correct": "achha",
      "acceptedVariants": [
        "accha",
        "acha"
      ],
      "explanation": "'Achha' means good. It is one of the most versatile Hindi words — used as 'good', 'okay', 'I see', and 'well then' depending on context and tone.",
      "hint": "sounds like: achha"
    },
