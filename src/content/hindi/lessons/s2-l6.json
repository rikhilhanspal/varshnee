        { "left": "satrah", "right": "17" },
        { "left": "atharah", "right": "18" }
      ],
      "explanation": "Numbers 15–18 — each must be memorized individually in Hindi."
    },
    {
      "id": "hi-s2-l6-ex03",
      "type": "multiple_choice",
      "question": "What is 'bees' in English?",
      "options": ["18", "19", "20", "16"],
      "correctIndex": 2,
      "explanation": "'Bees' means 20 in Hindi."
    },
    {
      "id": "hi-s2-l6-ex04",
      "type": "translation",
      "prompt": "19",
      "direction": "from_english",
      "correct": "unnis",
      "acceptedVariants": ["unnis"],
      "explanation": "'Unnis' = 19 in Hindi.",
      "hint": "sounds like: un-nis"
    },
    {
      "id": "hi-s2-l6-ex05",
      "type": "fill_in_blank",
      "sentence": "Pandrah, solah, satrah, ___, unnis. (15, 16, 17, ___, 19)",
      "correct": "atharah",
      "acceptedVariants": ["atharah"],
      "explanation": "'Atharah' = 18, coming between satrah (17) and unnis (19)."
    },
    {
      "id": "hi-s2-l6-ex06",
      "type": "translation",
      "prompt": "barah",
      "direction": "to_english",
      "correct": "12",
