        { "left": "chaudah", "right": "14" }
      ],
      "explanation": "Hindi numbers 11–14 are all unique words — not built from smaller numbers like in English."
    },
    {
      "id": "hi-s2-l6-ex02",
      "type": "matching",
      "pairs": [
        { "left": "pandrah", "right": "15" },
