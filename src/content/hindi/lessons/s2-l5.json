    {
      "id": "hi-s2-l5-ex02",
      "type": "multiple_choice",
      "question": "What does 'chacha' mean?",
      "options": [
        "Paternal uncle",
        "Maternal uncle",
        "Cousin",
        "Nephew"
      ],
      "correctIndex": 0,
      "explanation": "'Chacha' specifically means your father's brother. Hindi distinguishes between paternal and maternal relatives — your mother's brother is 'mama'."
    },
