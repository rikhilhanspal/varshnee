      "type": "multiple_choice",
      "question": "What does 'dudh' mean?",
      "options": [
        "Milk",
        "Water",
        "Tea",
        "Juice"
      ],
      "correctIndex": 0,
      "explanation": "'Dudh' means milk. Milk is widely consumed in India — 'dudh ki chai' (milk tea) is the standard way chai is prepared."
    },
    {
      "id": "hi-s3-l7-ex03",
      "type": "translation",
      "prompt": "How do you say 'I need water' in Hindi?",
      "direction": "from_english",
      "correct": "mujhe paani chahiye",
      "acceptedVariants": [
        "mujhe paani chaahiye"
      ],
      "explanation": "'Mujhe paani chahiye' — 'mujhe' (to me / I need), 'paani' (water), 'chahiye' (is needed). This is the standard way to express needing something.",
      "hint": "sounds like: mujhe paani chahiye"
    },
    {
      "id": "hi-s3-l7-ex04",
      "type": "fill_in_blank",
      "sentence": "Mujhe ___ chahiye.",
      "correct": "chai",
      "acceptedVariants": [
        "paani",
        "khaana",
        "roti",
        "dudh"
      ],
      "explanation": "The pattern 'mujhe ___ chahiye' means 'I need ___'. You can fill in any noun: chai (tea), paani (water), khaana (food), etc."
    },
    {
      "id": "hi-s3-l7-ex05",
      "type": "word_ordering",
      "prompt": "Say: I need food",
      "tiles": [
        {
          "id": "t1",
          "text": "chahiye"
        },
        {
          "id": "t2",
          "text": "khaana"
        },
        {
          "id": "t3",
          "text": "mujhe"
        }
      ],
      "correctOrder": [
        "t3",
        "t2",
        "t1"
      ],
      "explanation": "'Mujhe khaana chahiye' — subject ('mujhe' = to me), object ('khaana' = food), verb ('chahiye' = is needed). The verb comes last in Hindi."
    },
