      "type": "multiple_choice",
      "question": "What does 'daayein' mean?",
      "options": [
        "Right",
        "Left",
        "Straight",
        "Behind"
      ],
      "correctIndex": 0,
      "explanation": "'Daayein' means right (direction). Remember: 'baayein' = left, 'daayein' = right, 'seedha' = straight. 'Daayein muriye' = turn right."
