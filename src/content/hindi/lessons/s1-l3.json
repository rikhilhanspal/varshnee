      ],
      "correctIndex": 0,
      "explanation": "'Mujhe samajh nahin aaya' means 'I did not understand'. This is one of the most useful phrases when learning Hindi!"
    },
    {
      "id": "hi-s1-l3-ex05",
      "type": "fill_in_blank",
      "sentence": "Mujhe samajh ___ aaya.",
      "correct": "nahin",
      "acceptedVariants": [
        "nahi"
      ],
      "explanation": "'Nahin' (no/not) is placed before the verb to negate a sentence. 'Mujhe samajh nahin aaya' = 'I did not understand'."
    },
    {
      "id": "hi-s1-l3-ex06",
      "type": "word_ordering",
      "prompt": "Say: I did not understand",
      "tiles": [
