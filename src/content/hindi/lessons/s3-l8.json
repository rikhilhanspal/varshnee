      "id": "hi-s3-l8-ex01",
      "type": "matching",
      "pairs": [
        {
          "left": "jaana",
          "right": "to go"
        },
        {
          "left": "aana",
          "right": "to come"
        },
        {
          "left": "khaana",
          "right": "to eat"
        },
        {
          "left": "piina",
          "right": "to drink"
        },
        {
          "left": "bolna",
          "right": "to speak"
        }
      ],
      "explanation": "Hindi verb infinitives always end in '-na'. The root is found by removing '-na': jaa- (go), aa- (come), khaa- (eat), pii- (drink), bol- (speak)."
    },
    {
      "id": "hi-s3-l8-ex02",
      "type": "multiple_choice",
      "question": "What does 'bolna' mean?",
      "options": [
        "To speak",
        "To walk",
        "To eat",
        "To sleep"
      ],
      "correctIndex": 0,
      "explanation": "'Bolna' means 'to speak' or 'to say'. For example: 'Hindi bolna' means 'to speak Hindi'. 'Main Hindi bol sakta hoon' means 'I can speak Hindi'."
    },
    {
      "id": "hi-s3-l8-ex03",
      "type": "translation",
      "prompt": "How do you say 'I want to go' in Hindi?",
      "direction": "from_english",
      "correct": "main jaana chahta hoon",
      "acceptedVariants": [
        "main jaana chahti hoon",
        "mujhe jaana hai"
      ],
      "explanation": "'Main jaana chahta hoon' (male speaker) or 'main jaana chahti hoon' (female speaker). The pattern is: subject + infinitive + chahta/chahti + hoon.",
      "hint": "sounds like: main jaana chahta hoon"
    },
    {
      "id": "hi-s3-l8-ex04",
      "type": "fill_in_blank",
      "sentence": "Main chai ___ chahta hoon.",
      "correct": "piina",
      "acceptedVariants": [],
      "explanation": "'Main chai piina chahta hoon' means 'I want to drink tea'. The infinitive verb 'piina' (to drink) comes before 'chahta' (want)."
    },
    {
      "id": "hi-s3-l8-ex05",
      "type": "word_ordering",
      "prompt": "Say: I like to eat food",
      "tiles": [
        {
          "id": "t1",
          "text": "khaana"
        },
        {
          "id": "t2",
          "text": "hai"
        },
        {
          "id": "t3",
          "text": "mujhe"
        },
        {
          "id": "t4",
          "text": "pasand"
        },
        {
          "id": "t5",
          "text": "khaana"
        }
      ],
      "correctOrder": [
        "t3",
        "t1",
        "t5",
        "t4",
        "t2"
      ],
      "explanation": "'Mujhe khaana khaana pasand hai' — literally 'To me food eating liked is'. The first 'khaana' is the noun (food), the second is the verb (to eat)."
    },
