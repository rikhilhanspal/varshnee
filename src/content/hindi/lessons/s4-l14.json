      "type": "translation",
      "prompt": "aage",
      "direction": "to_english",
      "correct": "ahead / forward",
      "acceptedVariants": ["ahead", "forward", "in front"],
      "explanation": "'Aage' = ahead or in front. 'Aage jaaiye' = go forward/ahead. Opposite: 'peechhe' (behind)."
    },
    {
      "id": "hi-s4-l14-ex06",
      "type": "multiple_choice",
      "question": "What does 'peechhe' mean?",
      "options": ["left", "straight", "behind / back", "nearby"],
      "correctIndex": 2,
      "explanation": "'Peechhe' = behind or back. 'Peechhe muriye' = turn back. Opposite of 'aage' (ahead)."
    },
    {
      "id": "hi-s4-l14-ex07",
      "type": "word_ordering",
      "prompt": "Say 'go straight then turn right'",
      "tiles": [
        { "id": "t1", "text": "seedha" },
        { "id": "t2", "text": "jaaiye" },
        { "id": "t3", "text": "phir" },
        { "id": "t4", "text": "daayein" },
        { "id": "t5", "text": "muriye" }
      ],
      "correctOrder": ["t1", "t2", "t3", "t4", "t5"],
      "explanation": "'Seedha jaaiye, phir daayein muriye' = go straight, then turn right. 'Phir' = then."
