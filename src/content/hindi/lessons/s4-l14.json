      "prompt": "go straight",
      "direction": "from_english",
      "correct": "seedha jaaiye",
      "acceptedVariants": ["seedha jaaiye", "seedha jaao"],
      "explanation": "'Seedha jaaiye' = go straight (polite). Casual: 'seedha jaao'.",
      "hint": "sounds like: seed-haa jaa-i-yeh"
