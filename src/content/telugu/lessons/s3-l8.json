    {
      "id": "te-s3-l8-ex03",
      "type": "translation",
      "prompt": "I like coffee",
      "direction": "from_english",
      "correct": "naaku kaafii ishtam",
      "acceptedVariants": [
        "kaafii ishtam"
      ],
      "explanation": "'Naaku kaafii ishtam' - 'to me coffee liking'. Telugu uses 'ishtam' with 'naaku' to express likes.",
      "hint": "sounds like: naaku kaafii ishtam"
    },
    {
      "id": "te-s3-l8-ex04",
