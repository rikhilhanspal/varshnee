{
  "id": "s2-l5",
  "sectionId": "s2",
  "title": "Numbers 1–10",
  "description": "Learn to count from one to ten in Telugu.",
  "vocabularyIds": ["te-okati", "te-rendu", "te-muudu", "te-naalugu", "te-aidu", "te-aaru", "te-eedu", "te-enimidi", "te-tommidi", "te-padi"],
  "grammarNoteIds": [],
  "exercises": [
    {
      "id": "te-s2-l5-ex01",
      "type": "multiple_choice",
      "question": "What is 'aidu' in English?",
      "options": ["four", "five", "six", "seven"],
      "correctIndex": 1,
      "explanation": "'Aidu' means five (5) in Telugu."
    },
    {
      "id": "te-s2-l5-ex02",
      "type": "matching",
      "pairs": [
        { "left": "okati", "right": "1" },
        { "left": "rendu", "right": "2" },
        { "left": "muudu", "right": "3" },
        { "left": "naalugu", "right": "4" }
      ],
      "explanation": "Match each Telugu number word to its digit."
    },
    {
      "id": "te-s2-l5-ex03",
      "type": "translation",
      "prompt": "seven (7)",
      "direction": "from_english",
      "correct": "eedu",
      "acceptedVariants": ["eedu"],
      "explanation": "'Eedu' means seven in Telugu.",
      "hint": "sounds like: ay-du"
    },
    {
      "id": "te-s2-l5-ex04",
      "type": "translation",
      "prompt": "padi",
      "direction": "to_english",
      "correct": "ten",
      "acceptedVariants": ["ten", "10"],
      "explanation": "'Padi' means ten (10) in Telugu."
    },
    {
      "id": "te-s2-l5-ex05",
      "type": "word_ordering",
      "prompt": "Put these numbers in order: aaru, aidu, eedu",
      "tiles": [
        { "id": "t1", "text": "aidu" },
        { "id": "t2", "text": "aaru" },
        { "id": "t3", "text": "eedu" }
      ],
      "correctOrder": ["t1", "t2", "t3"],
      "explanation": "aidu=5, aaru=6, eedu=7. The correct order is 5, 6, 7."
    },
    {
      "id": "te-s2-l5-ex06",
      "type": "multiple_choice",
      "question": "What does 'enimidi' mean?",
      "options": ["six", "seven", "eight", "nine"],
      "correctIndex": 2,
      "explanation": "'Enimidi' means eight (8) in Telugu."
    },
    {
      "id": "te-s2-l5-ex07",
      "type": "fill_in_blank",
      "sentence": "___ (3) muudu, ___ (4) naalugu.",
      "correct": "muudu",
      "acceptedVariants": ["muudu"],
      "explanation": "'Muudu' is three in Telugu."
    },
    {
      "id": "te-s2-l5-ex08",
      "type": "translation",
      "prompt": "nine (9)",
      "direction": "from_english",
      "correct": "tommidi",
      "acceptedVariants": ["tommidi"],
      "explanation": "'Tommidi' means nine in Telugu.",
      "hint": "sounds like: tom-mee-dee"
    }
  ]
}
