      "type": "multiple_choice",
      "question": "What is 'pannendu' in English?",
      "options": ["eleven", "twelve", "thirteen", "fourteen"],
      "correctIndex": 1,
      "explanation": "'Pannendu' means twelve (12) in Telugu."
    },
    {
