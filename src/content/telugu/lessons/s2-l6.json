    {
      "id": "te-s2-l6-ex06",
      "type": "multiple_choice",
      "question": "What does 'pandommidi' mean?",
      "options": ["seventeen", "eighteen", "nineteen", "twenty"],
      "correctIndex": 2,
      "explanation": "'Pandommidi' means nineteen (19) in Telugu."
    },
    {
      "id": "te-s2-l6-ex07",
      "type": "word_ordering",
      "prompt": "Put in order: iravai, padiheedu, paddenimidi",
