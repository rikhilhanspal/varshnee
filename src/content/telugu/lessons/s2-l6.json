  "vocabularyIds": ["te-padakondu", "te-pannendu", "te-padammuudu", "te-padanaalugu", "te-padihenu", "te-padahaaru", "te-padiheedu", "te-paddenimidi", "te-pandommidi", "te-iravai"],
