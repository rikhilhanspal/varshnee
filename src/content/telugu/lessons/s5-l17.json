  "title": "Common Verbs",
  "description": "Learn the most useful Telugu verbs for everyday conversations.",
  "vocabularyIds": ["te-velluta", "te-raavadamu", "te-tinuta", "te-taaguta", "te-maatlaaduta", "te-chooduta"],
