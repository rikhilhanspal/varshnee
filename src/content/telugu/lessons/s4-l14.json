        { "id": "t2", "text": "tarvata" },
        { "id": "t3", "text": "neediga" }
      ],
      "correctOrder": ["t1", "t2", "t3"],
      "explanation": "'Edama, tarvata neediga' = left, then straight ahead."
    },
    {
      "id": "te-s4-l14-ex08",
      "type": "translation",
      "prompt": "right",
      "direction": "from_english",
      "correct": "kudivaipu",
      "acceptedVariants": ["kudivaipu"],
      "explanation": "'Kudivaipu' means right direction in Telugu.",
