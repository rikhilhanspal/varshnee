      "id": "te-s1-l2-ex01",
      "type": "multiple_choice",
      "question": "How do you ask 'what is your name?' in Telugu?",
      "options": ["elaa unnaru", "mee peru emandi", "namaskaaram", "vellostaanu"],
      "correctIndex": 1,
      "explanation": "'Mee peru emandi' is how you ask for someone's name — mee = your, peru = name."
    },
    {
      "id": "te-s1-l2-ex02",
      "type": "translation",
      "prompt": "my name is",
      "direction": "from_english",
      "correct": "naa peru",
      "acceptedVariants": ["naa peru", "na peru"],
      "explanation": "'Naa peru' means 'my name is' in Telugu.",
      "hint": "sounds like: naa peh-ru"
    },
    {
      "id": "te-s1-l2-ex03",
      "type": "matching",
      "pairs": [
        { "left": "mee peru emandi", "right": "what is your name" },
        { "left": "naa peru", "right": "my name is" },
        { "left": "meeday vooru", "right": "where are you from" },
        { "left": "mimmalni kalavadang saanthosham", "right": "pleased to meet you" }
      ],
      "explanation": "These phrases are used when meeting someone new in Telugu."
    },
    {
      "id": "te-s1-l2-ex04",
      "type": "translation",
      "prompt": "meeday vooru",
      "direction": "to_english",
      "correct": "where are you from",
      "acceptedVariants": ["where are you from", "where do you come from"],
      "explanation": "'Meeday vooru' literally means 'your town/village' — an informal way to ask where someone is from."
    },
    {
      "id": "te-s1-l2-ex05",
      "type": "fill_in_blank",
