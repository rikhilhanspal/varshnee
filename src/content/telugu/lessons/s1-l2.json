      "explanation": "Fill in any place name. 'Naenu ___ nundi vachchaanu' means 'I am from ___'."
    },
    {
      "id": "te-s1-l2-ex06",
      "type": "word_ordering",
      "prompt": "Arrange to say 'my name is'",
      "tiles": [
        { "id": "t1", "text": "naa" },
        { "id": "t2", "text": "peru" }
      ],
      "correctOrder": ["t1", "t2"],
      "explanation": "'Naa peru' = my name is. Then add your name after."
    },
    {
      "id": "te-s1-l2-ex07",
      "type": "translation",
      "prompt": "pleased to meet you",
      "direction": "from_english",
