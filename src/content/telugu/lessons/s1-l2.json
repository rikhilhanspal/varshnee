  "exercises": [
    {
      "id": "te-s1-l2-ex01",
      "type": "fill_in_blank",
      "sentence": "Naa ___ Ravi.",
      "correct": "peru",
      "acceptedVariants": [
        "peru"
      ],
      "explanation": "'Naa peru' means 'my name'. So 'Naa peru Ravi' means 'My name is Ravi'."
    },
    {
      "id": "te-s1-l2-ex02",
      "type": "multiple_choice",
      "question": "What does 'meeru ekkada nundi' mean?",
      "options": [
        "What is your name?",
        "How are you?",
        "Where are you from?",
        "Nice to meet you"
      ],
      "correctIndex": 2,
      "explanation": "'Meeru ekkada nundi' means 'Where are you from?' - 'meeru' (you, formal), 'ekkada' (where), 'nundi' (from)."
    },
    {
      "id": "te-s1-l2-ex03",
      "type": "translation",
      "prompt": "nice to meet you",
      "direction": "from_english",
      "correct": "naaku kalusukoni aanandam",
      "acceptedVariants": [
        "kalusukoni aanandam"
      ],
      "explanation": "'Naaku kalusukoni aanandam' means 'nice to meet you' - literally 'to me meeting happiness'.",
      "hint": "sounds like: naaku kalusukoni aanandam"
    },
