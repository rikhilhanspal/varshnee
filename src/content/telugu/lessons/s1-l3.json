      "type": "multiple_choice",
      "question": "How do you say 'please' in Telugu?",
      "options": [
        "avunu",
        "dayachesi",
        "kshaminchanddi",
        "ledu"
      ],
      "correctIndex": 1,
      "explanation": "'Dayachesi' means 'please' in Telugu."
    },
    {
      "id": "te-s1-l3-ex02",
      "type": "matching",
      "pairs": [
        {
          "left": "avunu",
          "right": "yes"
        },
        {
          "left": "kaadu",
          "right": "no (it is not)"
        },
        {
          "left": "ledu",
          "right": "no (there is not)"
        },
        {
          "left": "kshaminchanddi",
          "right": "sorry / excuse me"
        }
      ],
      "explanation": "Telugu has two words for 'no': 'kaadu' negates identity, 'ledu' negates existence."
    },
