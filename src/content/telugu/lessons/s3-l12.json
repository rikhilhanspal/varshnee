      "question": "What does 'angadi' mean?",
      "options": ["market", "shop / store", "bank", "school"],
      "correctIndex": 1,
      "explanation": "'Angadi' means shop or store in Telugu."
    },
    {
      "id": "te-s3-l12-ex02",
      "type": "translation",
      "prompt": "how much does this cost",
      "direction": "from_english",
      "correct": "dheeni dhara entha",
      "acceptedVariants": ["dheeni dhara entha"],
      "explanation": "The essential shopping question — ask for any item's price.",
      "hint": "sounds like: dhee-nee dhuh-ruh en-thuh"
    },
    {
      "id": "te-s3-l12-ex03",
      "type": "translation",
      "prompt": "dheeni dhara entha",
      "direction": "to_english",
      "correct": "how much does this cost",
      "acceptedVariants": ["how much does this cost", "how much is this", "what is the price"],
      "explanation": "'Dheeni dhara entha' = dheeni (this) + dhara (price) + entha (how much)."
    },
    {
      "id": "te-s3-l12-ex04",
      "type": "matching",
      "pairs": [
